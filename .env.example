# Copy to .env (never commit .env). Fill AT LEAST ONE key; the first one found is used
# in this order: OpenAI -> OpenRouter -> Gemini -> Anthropic -> Groq.
# Anthropic/Groq are chat-only: use another embedding provider or explicitly choose local.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Optional: force a provider instead of the order above
# LLM_PROVIDER=openai          # openai | openrouter | gemini | anthropic | groq
# EMBEDDING_PROVIDER=openai    # openai | openrouter | gemini | local
# Groq is chat-only. With only GROQ_API_KEY, explicitly choose EMBEDDING_PROVIDER=local.
# GROQ_CHAT_MODEL=openai/gpt-oss-20b
# LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Optional: override default models (<PROVIDER>_CHAT_MODEL / <PROVIDER>_EMBEDDING_MODEL)
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini
# OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# GEMINI_CHAT_MODEL=gemini-2.5-flash-lite
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# ANTHROPIC_CHAT_MODEL=claude-opus-5-5

# Must match NEO4J_AUTH used in `docker run`
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123
